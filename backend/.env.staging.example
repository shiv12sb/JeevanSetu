# ==============================================================================
# JEEVANSETU BACKEND — STAGING ENVIRONMENT CONFIGURATION (.env.staging.example)
# ==============================================================================
PORT=5000
NODE_ENV=staging
APP_ENV=staging
APP_VERSION=1.0.0-rc1
GIT_COMMIT_SHA=${GITHUB_SHA}
FRONTEND_URL=https://staging.jeevansetu.internal
LOG_LEVEL=INFO

# Dedicated Staging Supabase Database (Isolated from Production)
SUPABASE_URL=https://staging-project-id.supabase.co
SUPABASE_ANON_KEY=staging-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=staging-service-role-key-placeholder
SUPABASE_DB_PASSWORD=staging-db-password-placeholder

# Staging External Providers / Sandbox Gateways
MOCK_PROVIDERS=false
SMS_PROVIDER=FAST2SMS_SANDBOX
FAST2SMS_API_KEY=staging-sms-key-placeholder
EMAIL_PROVIDER=SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_USER=staging-mail-user
SMTP_PASS=staging-mail-pass
TELEPHONY_PROVIDER=MOCK
WEATHER_PROVIDER=OPENWEATHER
OPENWEATHER_API_KEY=staging-weather-key-placeholder

# Staging n8n Automation Instance
N8N_ENABLED=true
N8N_BASE_URL=https://n8n-staging.jeevansetu.internal
N8N_WEBHOOK_URL=https://n8n-staging.jeevansetu.internal/webhook/jeevansetu-events
N8N_WEBHOOK_SECRET=staging-n8n-webhook-secret-token

# Operational Settings
ENABLE_BACKGROUND_JOBS=true
BACKGROUND_JOB_INTERVAL_MS=300000
STUCK_JOB_THRESHOLD_MS=300000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
