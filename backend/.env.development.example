# ==============================================================================
# JEEVANSETU BACKEND — LOCAL DEVELOPMENT CONFIGURATION (.env.development.example)
# ==============================================================================
PORT=5000
NODE_ENV=development
APP_ENV=development
APP_VERSION=1.0.0-dev
GIT_COMMIT_SHA=local-dev
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=DEBUG

# In local development, all external providers default to in-memory mocks
MOCK_PROVIDERS=true
N8N_ENABLED=false
ENABLE_BACKGROUND_JOBS=true

# Optional local Supabase or cloud test project (works seamlessly in mock mode if unconfigured)
SUPABASE_URL=https://dev-project-id.supabase.co
SUPABASE_ANON_KEY=dev-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=dev-service-role-key-placeholder

# Optional local AI testing
AI_PROVIDER=MOCK
GEMINI_API_KEY=
