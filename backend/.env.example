# ==============================================================================
# JEEVANSETU BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# COPY TO .env OR SET IN CI/CD SECRET MANAGER. NEVER COMMIT ACTUAL SECRETS.

# 1. CORE SERVER SETTINGS (REQUIRED)
PORT=5000
NODE_ENV=development
APP_ENV=development
APP_VERSION=1.0.0
GIT_COMMIT_SHA=local-dev
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# 2. DATABASE & SUPABASE AUTH (REQUIRED FOR PRODUCTION / STAGING)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only
SUPABASE_DB_PASSWORD=your-database-password-keep-secure

# 3. AI SERVICES (OPTIONAL - FALLBACKS TO DETERMINISTIC ADVISORY MODE)
AI_PROVIDER=MOCK
GEMINI_API_KEY=
OPENAI_API_KEY=

# 4. EXTERNAL PROVIDERS & GATEWAYS (OPTIONAL - FALLS BACK TO MOCK/DEGRADED MODE)
MOCK_PROVIDERS=true
SMS_PROVIDER=MOCK
FAST2SMS_API_KEY=
EMAIL_PROVIDER=MOCK
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
TELEPHONY_PROVIDER=MOCK
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WEATHER_PROVIDER=MOCK
OPENWEATHER_API_KEY=

# 5. N8N AUTOMATION ORCHESTRATION (OPTIONAL - BACKEND HANDLES EVENTS DIRECTLY IF DISABLED)
N8N_ENABLED=false
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/jeevansetu-events
N8N_WEBHOOK_SECRET=jeevansetu-n8n-webhook-secret-token

# 6. OPERATIONAL SAFETY & BACKGROUND JOBS
ENABLE_BACKGROUND_JOBS=true
BACKGROUND_JOB_INTERVAL_MS=300000
STUCK_JOB_THRESHOLD_MS=300000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
