# ==============================================================================
# JEEVANSETU BACKEND — PRODUCTION ENVIRONMENT CONFIGURATION (.env.production.example)
# ==============================================================================
# SET SECURELY IN PRODUCTION HOSTING PLATFORM (RENDER / FLY.IO / RAILWAY SECRETS)
# NEVER STORE OR COMMIT ACTUAL PRODUCTION SECRETS IN REPOSITORY FILES

PORT=5000
NODE_ENV=production
APP_ENV=production
APP_VERSION=1.0.0
GIT_COMMIT_SHA=${GITHUB_SHA}
FRONTEND_URL=https://jeevansetu.gov.in
LOG_LEVEL=INFO

# Production Supabase PostgreSQL & Auth (Strictly Dedicated Production Instance)
SUPABASE_URL=https://production-project-id.supabase.co
SUPABASE_ANON_KEY=production-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=production-service-role-key-never-expose-to-client
SUPABASE_DB_PASSWORD=production-secure-db-password

# Production AI Grounding Engine
AI_PROVIDER=GEMINI
GEMINI_API_KEY=production-gemini-api-key-placeholder
OPENAI_API_KEY=

# Production External Telephony & Communication Gateways
MOCK_PROVIDERS=false
SMS_PROVIDER=FAST2SMS
FAST2SMS_API_KEY=production-fast2sms-api-key
EMAIL_PROVIDER=SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=production-sendgrid-api-key
TELEPHONY_PROVIDER=EXOTEL
EXOTEL_SID=production-exotel-sid
EXOTEL_TOKEN=production-exotel-token
WEATHER_PROVIDER=OPENWEATHER
OPENWEATHER_API_KEY=production-openweather-api-key

# Production n8n Event Orchestrator
N8N_ENABLED=true
N8N_BASE_URL=https://n8n.jeevansetu.gov.in
N8N_WEBHOOK_URL=https://n8n.jeevansetu.gov.in/webhook/jeevansetu-events
N8N_WEBHOOK_SECRET=production-crypto-random-32char-secret

# Production Observability & Rate Limiting Guardrails
ENABLE_BACKGROUND_JOBS=true
BACKGROUND_JOB_INTERVAL_MS=300000
STUCK_JOB_THRESHOLD_MS=300000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
