{
  "name": "05_early_warning_alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jeevansetu-early-warning-alert",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Early Warning Event Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{$env[\"EMAIL_ENDPOINT_URL\"] || \"https://api.email-gateway.local/v1/send\"}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"to\":\"district-health-officer@gadchiroli.gov.in\",\"subject\":\"JeevanSetu Alert: Statistical Public Health Anomaly Detected\",\"body\":\"An operational early warning anomaly has been detected. Human public-health investigation is required.\"}",
        "options": {}
      },
      "name": "Notify District Health Officer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300]
    }
  ],
  "connections": {
    "Early Warning Event Trigger": {
      "main": [
        [
          {
            "node": "Notify District Health Officer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
